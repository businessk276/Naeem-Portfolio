rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // The portfolio is public, but publishing requires Firebase Authentication.
    match /portfolio/JubartPortfolio {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
